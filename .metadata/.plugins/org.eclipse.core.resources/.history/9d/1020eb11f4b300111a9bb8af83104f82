global { 
	
	float cohesion_distance <- 15.0; 
	float separation_distance <- 3.0; 
	float alignment_distance <- 15.0; 
	float panic_distance <- 15.0; 
	
	
	init  { 
		
		create sheep number: 100 { 
			location <- {rnd(50), rnd(50)};
		}
		
		create obstacle number: 5 { 
			location <- {rnd(50), rnd(50)}; 
		}
		
		create dog number: 2 { 
			location <- {rnd(50), rnd(50)}; 
		}
	}
}

